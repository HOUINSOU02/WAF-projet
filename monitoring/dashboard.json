          {"matcher": {"id": "byName", "options": "XSS"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "LFI"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]},
          {"matcher": {"id": "byName", "options": "Command Injection"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]}
        ]
      }
    },
